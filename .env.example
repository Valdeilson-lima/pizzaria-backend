# Configuração do Servidor HTTP
PORT=3333

# Conexão com o Banco de Dados PostgreSQL (Prisma 7 com @prisma/adapter-pg)
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/DBPizzaria?schema=public"

# Segredo para assinatura de Tokens JWT
JWT_SECRET="defina_uma_chave_secreta_longa_e_segura_aqui"
